<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
          https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
  version="6.0">

  <!-- ServiceComb 3.x uses Spring Boot auto-configuration -->
  <!-- The ServiceComb REST servlet is handled by java-chassis-spring-boot-starter-servlet -->
  <!-- Note: Removed absolute-ordering to allow Spring Boot auto-configuration -->

  <!-- Legacy Filter Example - coexists with ServiceComb -->
  <filter>
    <filter-name>LegacyFilter</filter-name>
    <filter-class>org.apache.servicecomb.samples.dependencyManagement.LegacyFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>LegacyFilter</filter-name>
    <url-pattern>/legacy/*</url-pattern>
  </filter-mapping>

  <!-- Legacy Servlet Example - coexists with ServiceComb -->
  <servlet>
    <servlet-name>LegacyServlet</servlet-name>
    <servlet-class>org.apache.servicecomb.samples.dependencyManagement.LegacyServlet</servlet-class>
    <load-on-startup>2</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>LegacyServlet</servlet-name>
    <url-pattern>/legacy</url-pattern>
  </servlet-mapping>

  <!-- Welcome file for legacy JSP -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

</web-app>
